# Ignore all files by default, but scan all directories.
*
!*/

# Do not ignore git files in the root of the repo.
!/.git*

# Do not ignore current project's `.uproject`.
!/*.uproject

# Do not ignore AI agent instruction files in the root of the repo.
!/AGENTS.md
!/CLAUDE.md

# Do not ignore MCP client config files (local-only URLs, no secrets).
!/.mcp.json

# Do not ignore source, config and plugins dirs.
!/Source/**
!/Config/**
!/Plugins/**

# Do not ignore editor automation / tooling scripts.
!/Scripts/**

# But exclude plugin build artifacts (compiled output, intermediate files).
# These are regenerated on build and must not be committed.
# Later rules win, so this overrides the /Plugins/** allow-rule above.
/Plugins/*/Binaries/
/Plugins/*/Intermediate/
/Plugins/*/Saved/
/Plugins/*/DerivedDataCache/

# Only allow .uasset and .umap files from /Content dir.
# They're tracked by git-lfs, don't forget to track other
# files if adding them here.
!/Content/**/*.uasset
!/Content/**/*.umap

# Exclude the _Raw staging dir entirely (large imported source packs,
# e.g. downloaded Fab/marketplace packs — kept local-only, not committed).
# This overrides the /Content allow-rules above (later rules win).
/Content/_Raw/

# Allow any files from /RawContent dir.
# Any file in /RawContent dir will be managed by git lfs.
!/RawContent/**/*

# OS/platform generated files.

# Windows
ehthumbs.db
Thumbs.db

# Mac OS X
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory

# vim
[._]*.s[a-w][a-z]
[._]s[a-w][a-z]
*.un~
Session.vim
.netrwhist

# IDE
.vs
.vscode
.idea
